<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TaskBoard.Client.Views.MainWindow"
        x:Name="Root"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        Title="{Binding AppTitle}">
  <Grid RowDefinitions="Auto,*" Margin="18" RowSpacing="14">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="14">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding AppTitle}"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#0F172A" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="8">
          <TextBox Width="230"
                   Text="{Binding ServerUrl, Mode=TwoWay}"
                   Watermark="{Binding ServerLabel}" />
          <TextBox Width="180"
                   Text="{Binding UserName, Mode=TwoWay}"
                   Watermark="{Binding UserLabel}" />
          <Button Command="{Binding ConnectCommand}"
                  Content="{Binding ConnectButtonLabel}" />
          <TextBox Width="210"
                   Text="{Binding NewColumnTitle, Mode=TwoWay}"
                   Watermark="{Binding ColumnPlaceholder}" />
          <Button Classes="secondary"
                  Command="{Binding AddColumnCommand}"
                  Content="{Binding AddColumnLabel}" />
        </WrapPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
        <TextBlock Text="{Binding LanguageLabel}"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Right" />
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
          <Button Classes="secondary"
                  Command="{Binding SwitchLanguageCommand}"
                  CommandParameter="ru"
                  Content="RU" />
          <Button Classes="secondary"
                  Command="{Binding SwitchLanguageCommand}"
                  CommandParameter="en"
                  Content="EN" />
        </StackPanel>
        <TextBlock Text="{Binding Status}"
                   Foreground="#475569"
                   TextWrapping="Wrap"
                   MaxWidth="260"
                   HorizontalAlignment="Right" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,280" ColumnSpacing="14">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Columns}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="column">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Classes="danger"
                            Command="{Binding #Root.DataContext.DeleteColumnCommand}"
                            CommandParameter="{Binding}"
                            Content="X" />
                  </Grid>

                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Cards}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Classes="card"
                                  Margin="0,0,0,8"
                                  Command="{Binding #Root.DataContext.SelectCardCommand}"
                                  CommandParameter="{Binding}">
                            <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                              <TextBlock Text="{Binding Title}"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Description}"
                                         Foreground="#64748B"
                                         MaxLines="3"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <Button Grid.Row="2"
                          Classes="secondary"
                          Command="{Binding #Root.DataContext.AddCardCommand}"
                          CommandParameter="{Binding}"
                          Content="{Binding #Root.DataContext.AddCardLabel}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Column="1" Spacing="12">
        <Border Classes="details">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding OnlineLabel}"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding OnlineUsers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#DCFCE7"
                          CornerRadius="6"
                          Padding="8"
                          Margin="0,0,0,6">
                    <TextBlock Text="{Binding}" Foreground="#166534" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="details">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding DetailsLabel}"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding TitleLabel}" FontWeight="SemiBold" />
            <TextBox Text="{Binding SelectedCard.Title, Mode=TwoWay}"
                     IsEnabled="{Binding HasSelectedCard}" />
            <TextBlock Text="{Binding DescriptionLabel}" FontWeight="SemiBold" />
            <TextBox Text="{Binding SelectedCard.Description, Mode=TwoWay}"
                     AcceptsReturn="True"
                     MinHeight="150"
                     TextWrapping="Wrap"
                     IsEnabled="{Binding HasSelectedCard}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="secondary"
                      Command="{Binding MoveCardLeftCommand}"
                      Content="{Binding MoveLeftLabel}" />
              <Button Classes="secondary"
                      Command="{Binding MoveCardRightCommand}"
                      Content="{Binding MoveRightLabel}" />
            </StackPanel>
            <Button Command="{Binding SaveCardCommand}"
                    Content="{Binding SaveLabel}" />
            <Button Classes="danger"
                    Command="{Binding DeleteCardCommand}"
                    Content="{Binding DeleteCardLabel}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
