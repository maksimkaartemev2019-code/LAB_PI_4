<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TaskBoard.Client.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#F6F8FB" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Background" Value="#1D4ED8" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#E5E7EB" />
      <Setter Property="Foreground" Value="#111827" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#BE123C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.card">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#FFFFFF" />
    </Style>
    <Style Selector="Border.column">
      <Setter Property="Background" Value="#EAF1F8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="MinWidth" Value="250" />
      <Setter Property="MaxWidth" Value="310" />
    </Style>
    <Style Selector="Border.details">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </Application.Styles>
</Application>
